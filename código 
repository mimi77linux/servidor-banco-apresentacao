<script>

/* =========================================================
   NAVEGAÇÃO
========================================================= */

const sections = [...document.querySelectorAll("main section")];
const sideNav = document.getElementById("sideNav");

sections.forEach((section,index)=>{
    const button=document.createElement("button");
    button.className="dot";
    button.title=`Seção ${index+1}`;
    button.onclick=()=>goTo(section.id);
    sideNav.appendChild(button);
});

const dots=[...document.querySelectorAll(".dot")];

function goTo(id){
    document.getElementById(id)?.scrollIntoView({
        behavior:"smooth",
        block:"start"
    });
}

/* =========================================================
   PROGRESSO + SEÇÃO ATIVA
========================================================= */

function updateNavigation(){

    const scrollTop=window.scrollY;
    const docHeight=document.documentElement.scrollHeight-window.innerHeight;

    const percentage=docHeight>0
        ? (scrollTop/docHeight)*100
        : 0;

    document.getElementById("progress").style.width=
        `${Math.min(100,percentage)}%`;

    let activeIndex=0;

    sections.forEach((section,index)=>{
        const rect=section.getBoundingClientRect();

        if(rect.top <= window.innerHeight*.45){
            activeIndex=index;
        }
    });

    dots.forEach((dot,index)=>{
        dot.classList.toggle("active",index===activeIndex);
    });
}

window.addEventListener("scroll",updateNavigation);
updateNavigation();

/* =========================================================
   REVEAL ANIMATION
========================================================= */

const observer=new IntersectionObserver(
    entries=>{
        entries.forEach(entry=>{
            if(entry.isIntersecting){
                entry.target.classList.add("visible");
            }
        });
    },
    {threshold:.12}
);

document.querySelectorAll(".reveal").forEach(el=>{
    observer.observe(el);
});

/* =========================================================
   TEMA
========================================================= */

const themeBtn=document.getElementById("themeBtn");

function setTheme(light){

    document.body.classList.toggle("light",light);

    themeBtn.textContent=light ? "☀" : "☾";

    localStorage.setItem(
        "database-presentation-theme",
        light ? "light" : "dark"
    );
}

const savedTheme=localStorage.getItem(
    "database-presentation-theme"
);

setTheme(savedTheme==="light");

themeBtn.addEventListener("click",()=>{
    setTheme(!document.body.classList.contains("light"));
});

/* =========================================================
   FULLSCREEN
========================================================= */

document.getElementById("fullscreenBtn").addEventListener("click",async()=>{

    try{

        if(!document.fullscreenElement){
            await document.documentElement.requestFullscreen();
        }else{
            await document.exitFullscreen();
        }

    }catch(error){
        console.log("Fullscreen indisponível:",error);
    }

});

/* =========================================================
   TECLADO
========================================================= */

document.addEventListener("keydown",event=>{

    const current=sections.findIndex(section=>{
        const rect=section.getBoundingClientRect();
        return rect.top<=window.innerHeight*.45 &&
               rect.bottom>=window.innerHeight*.45;
    });

    if(event.key==="ArrowDown" || event.key==="PageDown"){
        event.preventDefault();

        const next=Math.min(
            sections.length-1,
            current+1
        );

        sections[next].scrollIntoView({
            behavior:"smooth"
        });
    }

    if(event.key==="ArrowUp" || event.key==="PageUp"){
        event.preventDefault();

        const previous=Math.max(
            0,
            current-1
        );

        sections[previous].scrollIntoView({
            behavior:"smooth"
        });
    }

});

/* =========================================================
   TERMINAL SQL SIMULADO
========================================================= */

const sqlInput=document.getElementById("sqlInput");
const terminalOutput=document.getElementById("terminalOutput");

sqlInput.addEventListener("keydown",event=>{

    if(event.key!=="Enter") return;

    const command=sqlInput.value.trim();

    if(!command) return;

    const line=document.createElement("div");

    line.innerHTML=
        `<span class="prompt">db&gt;</span> ${escapeHTML(command)}`;

    terminalOutput.insertBefore(line,sqlInput.parentElement);

    const result=document.createElement("div");

    const normalized=command.toLowerCase();

    if(normalized.includes("select")){

        result.innerHTML=
        `<span style="color:#22c55e">
        id | nome | status<br>
        01 | Miguel | ativo<br>
        02 | Ana    | ativo<br>
        03 | João   | ativo<br><br>
        3 registros retornados.
        </span>`;

    }else if(normalized.includes("insert")){

        result.innerHTML=
        `<span style="color:#22c55e">
        INSERT executado no modo demonstração.
        </span>`;

    }else if(normalized.includes("update")){

        result.innerHTML=
        `<span style="color:#22c55e">
        UPDATE executado no modo demonstração.
        </span>`;

    }else if(normalized.includes("delete")){

        result.innerHTML=
        `<span style="color:#f59e0b">
        DELETE reconhecido. Nenhum dado real foi alterado.
        </span>`;

    }else{

        result.innerHTML=
        `<span style="color:#91a4bc">
        Comando reconhecido apenas para demonstração.
        Tente: SELECT * FROM usuarios;
        </span>`;

    }

    terminalOutput.insertBefore(
        result,
        sqlInput.parentElement
    );

    sqlInput.value="";

    terminalOutput.scrollTop=
        terminalOutput.scrollHeight;

});

function escapeHTML(text){

    return text
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");

}

/* =========================================================
   QUIZ
========================================================= */

const options=document.querySelectorAll(".option");
const feedback=document.getElementById("feedback");

options.forEach(option=>{

    option.addEventListener("click",()=>{

        options.forEach(item=>{
            item.style.borderColor="";
        });

        if(option.dataset.correct==="true"){

            option.style.borderColor="rgba(34,197,94,.7)";

            feedback.textContent=
                "✓ Correto. O servidor/SGBD gerencia operações sobre os dados.";

            feedback.style.color="#22c55e";

        }else{

            option.style.borderColor="rgba(239,68,68,.7)";

            feedback.textContent=
                "✕ Essa alternativa não representa a função central de um servidor de banco.";

            feedback.style.color="#ef4444";
        }

    });

});

/* =========================================================
   MOBILE: SWIPE ENTRE SEÇÕES
========================================================= */

let touchStartY=0;

document.addEventListener("touchstart",event=>{
    touchStartY=event.changedTouches[0].screenY;
},{passive:true});

document.addEventListener("touchend",event=>{

    const touchEndY=event.changedTouches[0].screenY;
    const difference=touchStartY-touchEndY;

    if(Math.abs(difference)<70) return;

    const current=sections.findIndex(section=>{
        const rect=section.getBoundingClientRect();
        return rect.top<=window.innerHeight*.45 &&
               rect.bottom>=window.innerHeight*.45;
    });

    let target=current;

    if(difference>0){
        target=Math.min(sections.length-1,current+1);
    }else{
        target=Math.max(0,current-1);
    }

    sections[target].scrollIntoView({
        behavior:"smooth"
    });

},{passive:true});

/* =========================================================
   CONSOLE
========================================================= */

console.log(`
