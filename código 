<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07111f">
<title>Servidor de Banco de Dados | Miguel Silva</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap');

:root{
    --bg:#050a12;
    --bg2:#08111f;
    --panel:rgba(13,24,40,.78);
    --panel2:#0d1929;
    --line:rgba(255,255,255,.09);
    --text:#eef5ff;
    --muted:#91a4bc;
    --primary:#38bdf8;
    --secondary:#6366f1;
    --success:#22c55e;
    --warning:#f59e0b;
    --danger:#ef4444;
    --shadow:0 25px 80px rgba(0,0,0,.4);
}

.light{
    --bg:#eef4fa;
    --bg2:#f8fbff;
    --panel:rgba(255,255,255,.82);
    --panel2:#ffffff;
    --line:rgba(15,23,42,.1);
    --text:#0f172a;
    --muted:#53657c;
    --shadow:0 25px 70px rgba(15,23,42,.12);
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    min-height:100vh;
    font-family:Inter,Arial,sans-serif;
    color:var(--text);
    background:
        radial-gradient(circle at 15% 10%,rgba(56,189,248,.13),transparent 28%),
        radial-gradient(circle at 90% 80%,rgba(99,102,241,.12),transparent 30%),
        var(--bg);
    overflow-x:hidden;
}

button{
    font:inherit;
}

.progress{
    position:fixed;
    z-index:1000;
    top:0;
    left:0;
    width:0%;
    height:3px;
    background:linear-gradient(90deg,var(--primary),var(--secondary));
    box-shadow:0 0 18px var(--primary);
}

/* HEADER */

header{
    position:fixed;
    z-index:900;
    top:0;
    left:0;
    right:0;
    height:72px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 5%;
    border-bottom:1px solid var(--line);
    background:rgba(5,10,18,.68);
    backdrop-filter:blur(18px);
}

.light header{
    background:rgba(248,251,255,.75);
}

.brand{
    display:flex;
    align-items:center;
    gap:12px;
    font-weight:800;
    letter-spacing:-.5px;
}

.logo{
    width:38px;
    height:38px;
    border-radius:11px;
    display:grid;
    place-items:center;
    color:white;
    background:linear-gradient(135deg,var(--primary),var(--secondary));
    box-shadow:0 0 25px rgba(56,189,248,.2);
}

.header-actions{
    display:flex;
    gap:8px;
}

.icon-btn{
    width:40px;
    height:40px;
    border:1px solid var(--line);
    background:var(--panel);
    color:var(--text);
    border-radius:10px;
    cursor:pointer;
    transition:.2s;
}

.icon-btn:hover{
    transform:translateY(-2px);
    border-color:rgba(56,189,248,.5);
}

/* SIDE NAV */

.side-nav{
    position:fixed;
    z-index:800;
    left:24px;
    top:50%;
    transform:translateY(-50%);
    display:flex;
    flex-direction:column;
    gap:12px;
}

.dot{
    width:9px;
    height:9px;
    border-radius:50%;
    border:0;
    background:#526176;
    cursor:pointer;
    transition:.25s;
}

.dot.active{
    height:28px;
    border-radius:8px;
    background:var(--primary);
    box-shadow:0 0 15px rgba(56,189,248,.6);
}

/* MAIN */

main{
    width:min(1180px,90%);
    margin:auto;
}

section{
    min-height:100vh;
    padding:120px 0 80px;
    display:flex;
    align-items:center;
    position:relative;
}

.section-inner{
    width:100%;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    color:var(--primary);
    font-size:.76rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:2px;
    margin-bottom:18px;
}

.eyebrow::before{
    content:"";
    width:28px;
    height:1px;
    background:var(--primary);
}

h1{
    max-width:850px;
    font-size:clamp(3rem,7vw,6.7rem);
    line-height:.94;
    letter-spacing:-.065em;
}

h2{
    font-size:clamp(2rem,4vw,3.7rem);
    letter-spacing:-.045em;
    margin-bottom:18px;
}

h3{
    margin-bottom:9px;
}

.gradient{
    background:linear-gradient(100deg,var(--primary),#a78bfa);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
}

.lead{
    max-width:720px;
    margin-top:25px;
    color:var(--muted);
    font-size:1.08rem;
    line-height:1.8;
}

.actions{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:32px;
}

.btn{
    border:1px solid var(--line);
    border-radius:12px;
    padding:13px 18px;
    cursor:pointer;
    color:var(--text);
    background:var(--panel);
    transition:.2s;
    font-weight:700;
}

.btn.primary{
    color:#03101a;
    background:var(--primary);
    border-color:var(--primary);
}

.btn:hover{
    transform:translateY(-3px);
}

/* HERO */

.hero-grid{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:55px;
    align-items:center;
}

.server-visual{
    position:relative;
    height:420px;
    display:grid;
    place-items:center;
}

.server{
    width:290px;
    padding:20px;
    border:1px solid rgba(56,189,248,.3);
    border-radius:20px;
    background:linear-gradient(145deg,rgba(20,37,60,.9),rgba(6,15,27,.95));
    box-shadow:var(--shadow),0 0 60px rgba(56,189,248,.12);
}

.server-top{
    display:flex;
    justify-content:space-between;
    margin-bottom:22px;
}

.server-title{
    font-family:"JetBrains Mono",monospace;
    font-size:.8rem;
    color:var(--muted);
}

.status{
    color:var(--success);
    font-size:.72rem;
}

.rack{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.rack-line{
    height:45px;
    border:1px solid var(--line);
    border-radius:9px;
    background:#091321;
    display:flex;
    align-items:center;
    gap:8px;
    padding:8px;
}

.light-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:var(--success);
    box-shadow:0 0 9px var(--success);
}

.rack-bar{
    flex:1;
    height:6px;
    border-radius:10px;
    background:linear-gradient(90deg,#12334c,#1d4563,#12334c);
}

.orbit{
    position:absolute;
    width:390px;
    height:250px;
    border:1px solid rgba(56,189,248,.16);
    border-radius:50%;
    transform:rotate(-15deg);
}

.orbit::before,
.orbit::after{
    content:"";
    position:absolute;
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--primary);
    box-shadow:0 0 20px var(--primary);
}

.orbit::before{top:25px;left:75px}
.orbit::after{right:50px;bottom:20px}

/* CARDS */

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:16px;
    margin-top:38px;
}

.card{
    padding:25px;
    border:1px solid var(--line);
    border-radius:17px;
    background:var(--panel);
    backdrop-filter:blur(12px);
    box-shadow:0 10px 40px rgba(0,0,0,.12);
    transition:.3s;
}

.card:hover{
    transform:translateY(-6px);
    border-color:rgba(56,189,248,.35);
}

.card-icon{
    width:45px;
    height:45px;
    display:grid;
    place-items:center;
    border-radius:12px;
    background:rgba(56,189,248,.1);
    color:var(--primary);
    margin-bottom:20px;
    font-size:1.3rem;
}

.card p{
    color:var(--muted);
    line-height:1.65;
    font-size:.93rem;
}

/* ARCHITECTURE */

.architecture{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:14px;
    align-items:center;
    margin-top:42px;
}

.arch-box{
    min-height:150px;
    border:1px solid var(--line);
    border-radius:18px;
    background:var(--panel);
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:22px;
}

.arch-box strong{
    font-size:1.1rem;
}

.arch-box span{
    color:var(--muted);
    margin-top:8px;
    font-size:.85rem;
}

.arrow{
    text-align:center;
    font-size:1.8rem;
    color:var(--primary);
}

/* USE CASE */

.use-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-top:35px;
}

.use-card{
    padding:24px;
    border:1px solid var(--line);
    background:var(--panel);
    border-radius:17px;
}

.use-card .number{
    color:var(--primary);
    font-family:"JetBrains Mono";
    font-size:.75rem;
}

.use-card p{
    color:var(--muted);
    line-height:1.65;
}

/* SECURITY */

.security-layout{
    display:grid;
    grid-template-columns:.9fr 1.1fr;
    gap:30px;
    margin-top:35px;
}

.security-list{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.security-item{
    display:flex;
    gap:15px;
    padding:17px;
    border:1px solid var(--line);
    border-radius:14px;
    background:var(--panel);
}

.security-item b{
    display:block;
    margin-bottom:4px;
}

.security-item span{
    color:var(--muted);
    font-size:.86rem;
    line-height:1.5;
}

.check{
    width:30px;
    height:30px;
    flex:none;
    display:grid;
    place-items:center;
    border-radius:8px;
    background:rgba(34,197,94,.1);
    color:var(--success);
}

/* TOPICS */

.topic-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:14px;
    margin-top:35px;
}

.topic{
    border:1px solid var(--line);
    border-radius:15px;
    padding:20px;
    background:var(--panel);
}

.topic-header{
    display:flex;
    justify-content:space-between;
    gap:15px;
    margin-bottom:10px;
}

.topic-header span{
    color:var(--primary);
    font-family:"JetBrains Mono";
    font-size:.75rem;
}

.topic p{
    color:var(--muted);
    line-height:1.6;
    font-size:.9rem;
}

/* DATABASE TYPES */

.db-types{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    margin-top:35px;
}

.db{
    border:1px solid var(--line);
    background:var(--panel);
    border-radius:16px;
    padding:20px;
}

.db h3{
    font-size:1rem;
}

.db p{
    color:var(--muted);
    font-size:.83rem;
    line-height:1.55;
}

/* TERMINAL */

.terminal{
    margin-top:30px;
    border:1px solid var(--line);
    background:#03070d;
    border-radius:17px;
    overflow:hidden;
    box-shadow:var(--shadow);
}

.terminal-head{
    padding:11px 15px;
    border-bottom:1px solid rgba(255,255,255,.08);
    display:flex;
    gap:7px;
}

.term-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:#475569;
}

.terminal-body{
    padding:22px;
    font-family:"JetBrains Mono",monospace;
    color:#9fe8ff;
    min-height:230px;
    line-height:1.75;
    font-size:.86rem;
}

.prompt{
    color:#22c55e;
}

.term-input{
    background:none;
    border:0;
    outline:0;
    color:#fff;
    font-family:inherit;
    width:80%;
}

/* QUIZ */

.quiz{
    max-width:760px;
    margin:35px auto 0;
    border:1px solid var(--line);
    background:var(--panel);
    border-radius:20px;
    padding:28px;
}

.question{
    font-size:1.2rem;
    font-weight:700;
    line-height:1.5;
}

.options{
    display:grid;
    gap:10px;
    margin-top:20px;
}

.option{
    border:1px solid var(--line);
    background:var(--bg2);
    color:var(--text);
    text-align:left;
    padding:14px;
    border-radius:11px;
    cursor:pointer;
    transition:.2s;
}

.option:hover{
    border-color:var(--primary);
}

.feedback{
    margin-top:15px;
    min-height:24px;
    color:var(--muted);
}

/* FINAL */

.final-box{
    text-align:center;
    padding:60px 25px;
    border:1px solid var(--line);
    border-radius:25px;
    background:
        radial-gradient(circle at 50% 0%,rgba(56,189,248,.13),transparent 50%),
        var(--panel);
}

.final-box h2{
    margin-bottom:12px;
}

.creator{
    margin-top:30px;
    color:var(--muted);
    font-size:.9rem;
}

.creator strong{
    color:var(--text);
}

/* REVEAL */

.reveal{
    opacity:0;
    transform:translateY(25px);
    transition:.7s ease;
}

.reveal.visible{
    opacity:1;
    transform:none;
}

/* RESPONSIVE */

@media(max-width:900px){
    .hero-grid,
    .security-layout{
        grid-template-columns:1fr;
    }

    .cards{
        grid-template-columns:1fr 1fr;
    }

    .db-types{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:650px){
    header{
        padding:0 18px;
    }

    .brand span{
        display:none;
    }

    main{
        width:min(92%,1180px);
    }

    section{
        padding:105px 0 65px;
    }

    h1{
        font-size:3.4rem;
    }

    .side-nav{
        display:none;
    }

    .cards,
    .use-grid,
    .topic-grid,
    .db-types{
        grid-template-columns:1fr;
    }

    .architecture{
        grid-template-columns:1fr;
    }

    .arrow{
        transform:rotate(90deg);
    }

    .server-visual{
        height:330px;
    }

    .server{
        width:250px;
    }

    .orbit{
        width:310px;
        height:210px;
    }
}

/* PRINT */

@media print{
    header,.side-nav,.progress,.actions{
        display:none!important;
    }

    section{
        min-height:auto;
        page-break-after:always;
    }

    body{
        background:white;
        color:#111;
    }
}
</style>
</head>

<body>

<div class="progress" id="progress"></div>

<header>
    <div class="brand">
        <div class="logo">DB</div>
        <span>DATABASE SYSTEMS</span>
    </div>

    <div class="header-actions">
        <button class="icon-btn" id="themeBtn" title="Alternar tema">☾</button>
        <button class="icon-btn" id="fullscreenBtn" title="Tela cheia">⛶</button>
    </div>
</header>

<nav class="side-nav" id="sideNav"></nav>

<main>

<!-- 01 -->
<section id="inicio">
    <div class="section-inner hero-grid">
        <div class="reveal">
            <div class="eyebrow">Apresentação técnica • 01</div>

            <h1>
                Servidor de
                <span class="gradient">Banco de Dados</span>
            </h1>

            <p class="lead">
                Uma visão objetiva sobre como dados são armazenados,
                organizados, protegidos e disponibilizados para aplicações,
                sistemas e usuários.
            </p>

            <div class="actions">
                <button class="btn primary" onclick="goTo('funcao')">
                    Começar apresentação →
                </button>
                <button class="btn" onclick="goTo('arquitetura')">
                    Ver arquitetura
                </button>
            </div>
        </div>

        <div class="server-visual reveal">
            <div class="orbit"></div>

            <div class="server">
                <div class="server-top">
                    <span class="server-title">DB-SERVER / CORE</span>
                    <span class="status">● ONLINE</span>
                </div>

                <div class="rack">
                    <div class="rack-line">
                        <span class="light-dot"></span>
                        <div class="rack-bar"></div>
                    </div>

                    <div class="rack-line">
                        <span class="light-dot"></span>
                        <div class="rack-bar"></div>
                    </div>

                    <div class="rack-line">
                        <span class="light-dot"></span>
                        <div class="rack-bar"></div>
                    </div>

                    <div class="rack-line">
                        <span class="light-dot"></span>
                        <div class="rack-bar"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 02 -->
<section id="funcao">
    <div class="section-inner">
        <div class="reveal">
            <div class="eyebrow">Fundamento • 02</div>
            <h2>Qual é a <span class="gradient">função?</span></h2>
            <p class="lead">
                O servidor de banco de dados é responsável por processar
                operações sobre dados de maneira estruturada, controlada
                e, em muitos ambientes, simultânea para vários usuários.
            </p>
        </div>

        <div class="cards">
            <div class="card reveal">
                <div class="card-icon">▦</div>
                <h3>Armazenamento</h3>
                <p>
                    Mantém informações organizadas em estruturas como
                    tabelas, documentos, índices ou outros modelos de dados.
                </p>
            </div>

            <div class="card reveal">
                <div class="card-icon">⌕</div>
                <h3>Consultas</h3>
                <p>
                    Recebe consultas, localiza informações e devolve
                    resultados para aplicações e usuários autorizados.
                </p>
            </div>

            <div class="card reveal">
                <div class="card-icon">⇄</div>
                <h3>Transações</h3>
                <p>
                    Controla operações relacionadas para preservar a
                    consistência dos dados durante alterações.
                </p>
            </div>

            <div class="card reveal">
                <div class="card-icon">⚙</div>
                <h3>Gerenciamento</h3>
                <p>
                    Administra conexões, permissões, índices, recursos,
                    logs e outras operações do ambiente de dados.
                </p>
            </div>

            <div class="card reveal">
                <div class="card-icon">◈</div>
                <h3>Concorrência</h3>
                <p>
                    Permite que múltiplas operações ocorram de forma
                    coordenada, reduzindo conflitos entre acessos.
                </p>
            </div>

            <div class="card reveal">
                <div class="card-icon">↻</div>
                <h3>Recuperação</h3>
                <p>
                    Recursos de backup, logs e recuperação ajudam a
                    restaurar dados após falhas ou incidentes.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- 03 -->
<section id="arquitetura">
    <div class="section-inner">
        <div class="reveal">
            <div class="eyebrow">Arquitetura • 03</div>
            <h2>Como o sistema <span class="gradient">funciona?</span></h2>
            <p class="lead">
                Uma aplicação normalmente não manipula diretamente os arquivos
                internos do banco. Ela envia operações ao sistema gerenciador,
                que interpreta, valida e executa essas operações.
            </p>
        </div>

        <div class="architecture">
            <div class="arch-box reveal">
                <strong>Aplicação</strong>
                <span>Site • App • Sistema</span>
            </div>

            <div class="arrow">→</div>

            <div class="arch-box reveal">
                <strong>Servidor / SGBD</strong>
                <span>Processamento • Regras • Segurança</span>
            </div>

            <div class="arrow">→</div>

            <div class="arch-box reveal">
                <strong>Dados</strong>
                <span>Tabelas • Índices • Arquivos</span>
            </div>
        </div>

        <div class="cards">
            <div class="card reveal">
                <h3>Cliente</h3>
                <p>
                    É a aplicação que solicita operações sobre os dados.
                </p>
            </div>

            <div class="card reveal">
                <h3>SGBD</h3>
                <p>
                    Sistema responsável por gerenciar o banco e executar
                    as operações solicitadas.
                </p>
            </div>

            <div class="card reveal">
                <h3>Persistência</h3>
                <p>
                    Camada onde as informações permanecem armazenadas
                    para utilização posterior.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- 04 -->
<section id="uso">
    <div class="section-inner">
        <div class="reveal">
            <div class="eyebrow">Aplicações • 04</div>
            <h2>Onde ele é <span class="gradient">usado?</span></h2>
            <p class="lead">
                Bancos de dados aparecem em praticamente qualquer sistema
                que precise guardar informações de maneira persistente.
            </p>
        </div>

        <div class="use-grid">

            <div class="use-card reveal">
                <div class="number">01 / E-COMMERCE</div>
                <h3>Comércio eletrônico</h3>
                <p>
                    Produtos, clientes, pedidos, pagamentos, estoque
                    e histórico de compras.
                </p>
            </div>

            <div class="use-card reveal">
                <div class="number">02 / FINANCEIRO</div>
                <h3>Sistemas financeiros</h3>
                <p>
                    Contas, transações, registros e operações que exigem
                    controle rigoroso dos dados.
                </p>
            </div>

            <div class="use-card reveal">
                <div class="number">03 / SAAS</div>
                <h3>Aplicações online</h3>
                <p>
                    Usuários, configurações, permissões, conteúdo e
                    informações de serviços digitais.
                </p>
            </div>

            <div class="use-card reveal">
